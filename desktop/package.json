{
  "name": "bear-editor-desktop",
  "productName": "Bear Editor",
  "version": "0.1.0",
  "description": "Offline Elasto Mania level editor",
  "author": "Pablo Corso",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.beareditor.desktop",
    "files": [
      "main.mjs",
      "preload.cjs",
      "build/client/**/*"
    ],
    "directories": {
      "buildResources": "resources"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Graphics",
      "icon": "build/client/favicons/android-chrome-512x512.png"
    },
    "publish": {
      "provider": "github",
      "owner": "PabloCorso",
      "repo": "bear-editor"
    }
  }
}
